  "components": {
    "schemas": {
      "CarDetails": {
        "required": [
          "availability_status",
          "maker",
          "model",
          "rental_Price"
        ],
        "type": "object",
        "properties": {
          "vehicle_Id": {
            "type": "integer",
            "format": "int32"
          },
          "maker": {
            "maxLength": 100,
            "type": "string"
          },
          "model": {
            "maxLength": 100,
            "type": "string"
          },
          "rental_Price": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "availability_status": {
            "type": "string"
          },
          "image_Link": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NewLoginDto": {
        "type": "object",
        "properties": {
