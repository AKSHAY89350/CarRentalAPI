  "components": {
    "schemas": {
      "CarDetails": {
        "required": [
          "Availability_status",
          "Maker",
          "Model",
          "Rental_Price"
        ],
        "type": "object",
        "properties": {
          "Vehicle_Id": {
            "type": "integer",
            "format": "int32"
          },
          "Maker": {
            "maxLength": 100,
            "type": "string"
          },
          "Model": {
            "maxLength": 100,
            "type": "string"
          },
          "Rental_Price": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "Availability_status": {
            "type": "string"
          },
          "Image_Link": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginnDTO": {
        "required": [
          "ClientId",
          "Email",
          "Password"
        ],
        "type": "object",
        "properties": {
          "Email": {
            "maxLength": 100,
            "type": "string",
            "format": "email"
          },
          "Password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          },
          "ClientId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Product": {
        "required": [
          "Name"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "Description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "Price": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "RegisterDTO": {
        "required": [
          "Email",
          "Firstname",
          "Password"
        ],
        "type": "object",
        "properties": {
          "Firstname": {
            "maxLength": 50,
            "type": "string"
          },
          "Lastname": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "Email": {
            "maxLength": 100,
            "type": "string",
            "format": "email"
          },
          "Password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RentalAgreementDto": {
        "type": "object",
        "properties": {
          "RentalAgreementId": {
            "type": "integer",
            "format": "int32"
          },
          "UserId": {
            "type": "integer",
            "format": "int32"
          },
          "Vehicle_Id": {
            "type": "integer",
            "format": "int32"
          },
          "BookingDate": {
            "type": "string",
            "format": "date-time"
          },
          "ReturnDate": {
            "type": "string",
            "format": "date-time"
          },
          "IsReturned": {
            "type": "string",
            "nullable": true
          },
          "RequestForReturn": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateProfileDTO": {
        "type": "object",
        "properties": {
          "Firstname": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "Lastname": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "Email": {
            "maxLength": 100,
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "Password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
